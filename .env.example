# =============================================================================
# Gateway — local development (copy to .env)
# =============================================================================
PORT=3000
NODE_ENV=development
TRUST_PROXY=false
REQUEST_BODY_LIMIT_BYTES=1048576

# Upstream APIs
AUTH_UPSTREAM_URL=http://localhost:4001
DIARY_UPSTREAM_URL=http://localhost:4281
SETTINGS_UPSTREAM_URL=http://localhost:4381
TASKS_UPSTREAM_URL=http://localhost:4481

# Upstream Next.js dev apps (single origin via gateway)
SHELL_UPSTREAM_URL=http://localhost:3001
DIARY_APP_UPSTREAM_URL=http://localhost:4280
SETTINGS_APP_UPSTREAM_URL=http://localhost:4380
TASKS_APP_UPSTREAM_URL=http://localhost:4480

UPSTREAM_TIMEOUT_MS=30000

RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_SECONDS=60
AUTH_RATE_LIMIT_MAX=5
AUTH_RATE_LIMIT_WINDOW_SECONDS=60

LOG_LEVEL=info

# Versioned JWKS on auth-service
AUTH_JWKS_URL=http://localhost:4001/v1/.well-known/jwks.json

# ── Service tokens (each ≥32 chars; must match downstream “GATEWAY_SERVICE_TOKEN”) ──
# Easiest local setup: use the SAME value for all three. Generate for production:
#   openssl rand -hex 32
#
DIARY_SERVICE_TOKEN=local-dev-omniradon-service-token-min-32-chars-required
SETTINGS_SERVICE_TOKEN=local-dev-omniradon-service-token-min-32-chars-required
TASKS_SERVICE_TOKEN=local-dev-omniradon-service-token-min-32-chars-required
